[codespell]
# Dictionaries. `clear` catches typos, `code` catches code-specific spelling, plus
# rare/names/informal.
#
# `en-GB_to_en-US` is deliberately NOT enabled. This codebase writes Commonwealth
# English throughout -- authorises, cancelled, fulfilment, colour, honouring,
# standardised, -ise verbs -- so that conversion flagged correct prose on every run
# (about half the failures). The gate exists to catch typos, not to choose a dialect
# the project has not adopted.
builtin = clear,rare,names,informal,code
check-filenames =
check-hidden =
# Not ours to spell-check:
#   external/  -- vendored cpp-httplib + the fltk/rist-cpp/sdp-tools submodules
#   .agents/   -- gsdd scaffolding, regenerated by the tool, not edited by hand
#   .opencode/ -- the same scaffolding mirrored for OpenCode
#   build*     -- generated build trees (a developer's local tree, too)
skip = */.git,*/build,*/build-*,*/prefix,*/external,*/.agents,*/.opencode
quiet-level = 2
# Correct here, but absent from codespell's dictionaries:
#   deque       -- the C++ container (std::deque), not "dequeue"
#   wan / WAN   -- the network, not "want"
#   reencode    -- this project's own term for re-encoding
#   unparseable -- a valid spelling (codespell prefers "unparsable")
#   copyable    -- the standard spelling (codespell prefers "copiable")
#   fulfilment  -- the Commonwealth spelling (codespell wants the US "fulfillment");
#                  flagged by the base dictionary, not just the dialect one
ignore-words-list = deque,wan,reencode,unparseable,copyable,fulfilment
